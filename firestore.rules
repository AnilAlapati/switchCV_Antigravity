rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // System collection - ID counters (server-side only)
    match /system/{document} {
      // Only allow server-side writes (no client access)
      allow read: if false;
      allow write: if false;
    }
    
    // Allow users to read/write their own resumes
    match /resumes/{resumeId} {
      allow read: if true; // Public read access for resumes
      
      // Allow creation with any ID (numeric or alphanumeric from our system)
      allow create: if request.auth != null 
                    || request.resource.data.keys().hasAll(['name', 'email']);
      
      // Only owner can update/delete (if userId is set)
      allow update, delete: if request.auth != null 
                            && request.auth.uid == resource.data.userId;
    }
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
